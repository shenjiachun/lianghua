<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lianghua.infrastructure.persistence.mapper.AnalysisResultMapper">

    <resultMap id="AnalysisResultMap" type="com.lianghua.infrastructure.persistence.do_.AnalysisResultDO">
        <id property="id" column="id"/>
        <result property="stockCode" column="stock_code"/>
        <result property="analysisType" column="analysis_type"/>
        <result property="aiModel" column="ai_model"/>
        <result property="prompt" column="prompt"/>
        <result property="content" column="content"/>
        <result property="suggestion" column="suggestion"/>
        <result property="confidenceScore" column="confidence_score"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.lianghua.infrastructure.persistence.do_.AnalysisResultDO">
        INSERT INTO t_analysis_result (id, stock_code, analysis_type, ai_model, prompt, content,
                                       suggestion, confidence_score, created_at)
        VALUES (#{id}, #{stockCode}, #{analysisType}, #{aiModel}, #{prompt}, #{content},
                #{suggestion}, #{confidenceScore}, #{createdAt})
    </insert>

    <select id="selectById" resultMap="AnalysisResultMap">
        SELECT * FROM t_analysis_result WHERE id = #{id}
    </select>

    <select id="selectByStockCode" resultMap="AnalysisResultMap">
        SELECT * FROM t_analysis_result
        WHERE stock_code = #{stockCode}
        <if test="startDate != null">
            AND DATE(created_at) &gt;= #{startDate}
        </if>
        <if test="endDate != null">
            AND DATE(created_at) &lt;= #{endDate}
        </if>
        ORDER BY created_at DESC
    </select>

    <select id="selectByStockCodeAndType" resultMap="AnalysisResultMap">
        SELECT * FROM t_analysis_result
        WHERE stock_code = #{stockCode}
        <if test="analysisType != null and analysisType != ''">
            AND analysis_type = #{analysisType}
        </if>
        ORDER BY created_at DESC
    </select>

</mapper>
